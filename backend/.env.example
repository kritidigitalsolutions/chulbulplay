# SabPaisa PG 3.0 (test / staging)
SABPAISA_MODE=test
SABPAISA_API_KEY=your_staging_api_key
SABPAISA_SECRET_KEY=your_staging_secret_key
SABPAISA_MERCHANT_ID=your_staging_merchant_id
