          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/episodes/search?q=Episode&seriesId={{id}}"
          }
        },
        {
          "name": "Update episode",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Updated Episode",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/admin/episodes/{{id}}"
          }
        },
        {
          "name": "Delete episode",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/episodes/{{id}}"
          }
        },
        {
          "name": "Delete season",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/episodes/season/{{id}}/1"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get Active Payment Gateways",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payment/gateways"
          }
        },
        {
          "name": "Razorpay - Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{id}}\",\n  \"promoCode\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/payment/razorpay/create-order"
          }
        },
        {
          "name": "Razorpay - Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_xxx\",\n  \"razorpay_payment_id\": \"pay_xxx\",\n  \"razorpay_signature\": \"xxx\"\n}"
            },
            "url": "{{baseUrl}}/api/payment/razorpay/verify"
          }
        },
        {
          "name": "Easebuzz - Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{id}}\",\n  \"name\": \"Customer Name\",\n  \"email\": \"customer@example.com\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": "{{baseUrl}}/api/payment/easebuzz/initiate"
          }
        },
        {
          "name": "Easebuzz - Check Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/payment/easebuzz/status/{{orderId}}"
          }
        },
        {
          "name": "Admin - Get Payment Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payment-settings"
          }
        },
        {
          "name": "Admin - Update Payment Settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayEnabled\": true,\n  \"easebuzzEnabled\": true,\n  \"easebuzzMode\": \"live\",\n  \"defaultGateway\": \"razorpay\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/payment-settings"
          }
        }
      ]
    }
