            "url": "{{baseUrl}}/api/admin/banners"
          }
        },
        {
          "name": "Get All Banners (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/banners"
          }
        },
        {
          "name": "Update Banner",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Summer Mega Offer - Stream Now\",\n  \"linkUrl\": \"/plans\",\n  \"priority\": 2,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/banners/{{bannerId}}"
          }
        },
        {
          "name": "Delete Banner",
          "request": {
            "method": "DELETE",
