                  "    pm.collectionVariables.set('bannerId', res.banner._id || res.banner.id);",
                  "    console.log('Saved bannerId:', pm.collectionVariables.get('bannerId'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Stream Unlimited Blockbusters\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85\",\n  \"linkUrl\": \"/subscription\",\n  \"category\": \"Trending\",\n  \"description\": \"Watch trending movies and web series in 4K HDR\",\n  \"priority\": 1,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/banners"
          }
        },
